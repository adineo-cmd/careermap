---
interface Props {
  title: string;
  head?: string;
  body?: string;
}
const { title, head = "", body = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Fragment set:html={head} />
  </head>
  <body>
    <Fragment set:html={body} />
  </body>
</html>
